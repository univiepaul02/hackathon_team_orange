# IBM API Gateway (LiteLLM proxy, OpenAI-compatible)
IBM_API_KEY=your-new-key-here
IBM_API_BASE=https://api.servicesessentials.ibm.com/v1

# Model names exposed by the proxy
# LLM_MODEL=gpt-4o          (GPT-4o)
# LLM_MODEL=claude-haiku-5-5  (Claude Haiku 3.5)
LLM_MODEL=gpt-4o

# Embeddings are now handled locally via sentence-transformers (all-MiniLM-L6-v2)
# No EMBED_MODEL needed.
